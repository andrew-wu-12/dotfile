{
  "permissions": {
    "allow": [
      "Read(~/project/mop-console-monorepo/**)",
      "Read(~/personal/office-note/**)"
    ],
    "ask": [
      "mcp__codex__codex",
      "mcp__codex__codex-reply"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/tmux-agent-notify.sh notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/tmux-agent-notify.sh stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/tmux-agent-notify.sh clear"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in */skills/*.md) jq -n --arg f \"$f\" \"{hookSpecificOutput:{hookEventName:\\\"PostToolUse\\\",additionalContext:(\\\"Skill file changed: \\\" + \\$f + \\\". When you finish editing this file, run the asd-ste100 skill on it and apply its rewrite before you report the skill as done.\\\")}}\";; esac"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "pilotfish@pilotfish": true,
    "ponytail@ponytail": true,
    "workmux-status@workmux": true
  },
  "extraKnownMarketplaces": {
    "pilotfish": {
      "source": {
        "source": "github",
        "repo": "Nanako0129/pilotfish",
        "ref": "v1.4.1"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "workmux": {
      "source": {
        "source": "github",
        "repo": "raine/workmux"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "mcpServers": {
    "codex": {
      "command": "/bin/zsh",
      "args": [
        "-c",
        "source ~/.nvm/nvm.sh && nvm use 20.19 >/dev/null && OPENAI_API_KEY=\"$(~/bin/cred-read.sh openai.com)\" codex mcp-server"
      ]
    },
    "chrome-devtools": {
      "command": "/bin/zsh",
      "args": [
        "-c",
        "source ~/.nvm/nvm.sh && nvm use 20.19 >/dev/null && npx -y chrome-devtools-mcp@1.10.1"
      ]
    }
  }
}
